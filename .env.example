OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ALLOWED_PROVIDERS=google-ai-studio
OPENROUTER_DATA_COLLECTION=deny
ROOM_PORT=8787
PORT=3000
# Public WebSocket address only (never place secrets in NEXT_PUBLIC variables)
NEXT_PUBLIC_ROOM_WS_URL=
# Optional JSON array with STUN/TURN configuration. Empty supports local peers.
NEXT_PUBLIC_ICE_SERVERS=[]
TRANSLATION_RPM=18
TRANSLATION_CONCURRENCY=2
TRANSLATION_QUEUE_PER_ROOM=2
TRANSLATION_TIMEOUT_MS=5000

